# =============================================================================
# Sovereign On-Premise Agentic AI Workbench — Environment Variables
# =============================================================================
# Copy this file to .env and edit as needed.
# All values shown are defaults.

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
APP_NAME=SovereignAIWorkbench
APP_ENV=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Backend Server
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Ollama (Local Model Provider)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# -----------------------------------------------------------------------------
# OpenAI-Compatible Provider (Optional)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_DEFAULT_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# OpenRouter (Optional)
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# RAG / Embeddings
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
CHROMA_PERSIST_DIR=./data/chromadb
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# -----------------------------------------------------------------------------
# Tool Execution
# -----------------------------------------------------------------------------
SANDBOX_DIR=./data/sandbox
CODE_EXEC_TIMEOUT=30
MAX_FILE_SIZE_MB=50

# -----------------------------------------------------------------------------
# Data Paths
# -----------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
LOG_DIR=./data/logs

# -----------------------------------------------------------------------------
# Phase 7 & Phase B Step 9: Authentication, Session & Production Security
# -----------------------------------------------------------------------------
AUTH_ENABLED=false
AUTH_IDLE_TIMEOUT_SECONDS=28800
AUTH_MAX_SESSION_SECONDS=86400
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_SECONDS=900
# Production cookie security: set to true in production HTTPS deployments.
# If set to false in production, a trusted TLS-terminating reverse proxy is required.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=.example.internal
# Set to true only if interactive API documentation is needed in production:
ENABLE_DOCS_IN_PROD=false

# -----------------------------------------------------------------------------
# Phase B Step 8: Code Execution Isolation
# -----------------------------------------------------------------------------
# Isolation backend: 'subprocess' (hardened local subprocess) or 'docker' (container isolation)
CODE_EXEC_ISOLATION=subprocess
CODE_EXEC_DOCKER_IMAGE=sovereign-code-sandbox:latest
CODE_EXEC_DOCKER_MEMORY_MB=512
CODE_EXEC_DOCKER_CPUS=1.0
CODE_EXEC_DOCKER_PIDS_LIMIT=64
